<UserControl x:Class="RetroClip.ClipPlaybackPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="160"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Section titles -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*" MinWidth="340"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Playback / stream"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="#7FFFD4"/>
                <TextBlock Style="{StaticResource MutedText}"
                           FontSize="12"
                           Text="Full-clip preview / stream."
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Soundboard"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="#7FFFD4"/>
                <TextBlock Style="{StaticResource MutedText}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"
                           Text="Left-click streams · right-click Assign / Clear."/>
            </StackPanel>
        </Grid>

        <!-- Unified clip picker -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="140" MinWidth="100"/>
                <ColumnDefinition Width="*" MinWidth="160"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource LabelText}"
                       Text="Clip"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            <TextBox x:Name="ClipSearchBox"
                     Grid.Column="1"
                     Padding="8,6"
                     VerticalContentAlignment="Center"
                     Margin="0,0,8,0"
                     ToolTip="Search clips (case-insensitive)"
                     TextChanged="ClipSearchBox_TextChanged"/>
            <ComboBox x:Name="ClipCombo"
                      Grid.Column="2"
                      DisplayMemberPath="FileName"
                      SelectionChanged="ClipCombo_SelectionChanged"/>
            <Button Grid.Column="3"
                    Content="Refresh"
                    Style="{StaticResource PillButton}"
                    Margin="8,0,0,0"
                    Click="RefreshClips_Click"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*" MinWidth="340"/>
            </Grid.ColumnDefinitions>

            <!-- Playback / stream devices -->
            <StackPanel Grid.Column="0">
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource LabelText}" Text="Preview output" VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right"
                            Content="Refresh"
                            Style="{StaticResource PillButton}"
                            Padding="12,6"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Click="RefreshDevices_Click"/>
                </DockPanel>
                <ComboBox x:Name="PreviewOutputCombo"
                          DisplayMemberPath="FriendlyName"
                          Margin="0,0,0,8"
                          SelectionChanged="PlaybackDevice_SelectionChanged"/>

                <TextBlock Style="{StaticResource LabelText}" Text="Stream to virtual mic" Margin="0,0,0,4"/>
                <ComboBox x:Name="StreamTargetCombo"
                          DisplayMemberPath="FriendlyName"
                          Margin="0,0,0,6"
                          SelectionChanged="PlaybackDevice_SelectionChanged"/>
                <CheckBox x:Name="AlsoHearLocallyCheck"
                          Content="Also hear locally"
                          IsChecked="True"
                          Checked="AlsoHearLocallyCheck_Changed"
                          Unchecked="AlsoHearLocallyCheck_Changed"/>
            </StackPanel>

            <!-- Soundboard: preset then pads -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="80"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource LabelText}"
                               Text="Preset"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <TextBox x:Name="SoundboardPresetNameBox"
                             Grid.Column="1"
                             Padding="8,6"
                             VerticalContentAlignment="Center"
                             ToolTip="Type a preset name, or leave blank to use the selected preset"/>
                    <ComboBox x:Name="SoundboardPresetPickCombo"
                              Grid.Column="2"
                              MinWidth="110"
                              Margin="10,0,0,0"
                              ToolTip="Pick an existing preset"/>
                    <Button Grid.Column="3"
                            Content="Load"
                            Style="{StaticResource PillButton}"
                            Margin="10,0,0,0"
                            Padding="12,6"
                            MinWidth="68"
                            Click="SoundboardPresetLoad_Click"/>
                    <Button Grid.Column="4"
                            Content="Save"
                            Style="{StaticResource PillButton}"
                            Margin="10,0,0,0"
                            Padding="12,6"
                            MinWidth="68"
                            Click="SoundboardPresetSave_Click"/>
                    <Button Grid.Column="5"
                            Content="Delete"
                            Style="{StaticResource PillButton}"
                            Margin="10,0,0,0"
                            Padding="12,6"
                            MinWidth="68"
                            Click="SoundboardPresetDelete_Click"/>
                </Grid>

                <UniformGrid x:Name="SoundboardGrid"
                             Grid.Row="1"
                             Rows="4"
                             Columns="4"
                             Margin="0,0,0,4"/>
            </Grid>
        </Grid>

        <!-- Shared transport -->
        <Border Grid.Row="3"
                Margin="0,12,0,0"
                Padding="0,10,0,0"
                BorderBrush="#3D3D3D"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Style="{StaticResource LabelText}" Text="Transport"/>
                    <TextBlock x:Name="PlaybackLabel"
                               Style="{StaticResource MutedText}"
                               FontSize="12"
                               Margin="0,8,0,0"
                               Text="Stopped"/>
                </StackPanel>

                <ProgressBar x:Name="PlaybackProgress"
                             Grid.Column="1"
                             Minimum="0"
                             Maximum="1"
                             Value="0"
                             Height="10"
                             VerticalAlignment="Center"
                             Margin="0,0,16,0"/>

                <WrapPanel Grid.Column="2" VerticalAlignment="Center">
                    <Button x:Name="PreviewButton"
                            Content="Preview"
                            Style="{StaticResource AccentPillButton}"
                            Click="Preview_Click"
                            MinWidth="90"
                            Margin="0,0,8,0"/>
                    <Button Content="Stream"
                            Style="{StaticResource AccentPillButton}"
                            Click="Stream_Click"
                            MinWidth="90"
                            Margin="0,0,8,0"/>
                    <Button Content="Stop"
                            Style="{StaticResource PillButton}"
                            Click="Stop_Click"
                            MinWidth="72"/>
                </WrapPanel>
            </Grid>
        </Border>

        <TextBlock x:Name="StatusText"
                   Grid.Row="4"
                   TextWrapping="Wrap"
                   Style="{StaticResource MutedText}"
                   FontSize="12"
                   Margin="0,10,0,0"
                   Text="Ready."/>
    </Grid>
</UserControl>
