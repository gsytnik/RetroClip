<UserControl x:Class="RetroClip.ClipEditPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,6">
            <TextBlock Text="Edit clip"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#7FFFD4"/>
            <TextBlock Style="{StaticResource MutedText}"
                       FontSize="12"
                       Text="Pick a clip, fine-tune trim, save or delete."
                       Margin="0,2,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="110" MinWidth="80"/>
                <ColumnDefinition Width="*" MinWidth="120"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource LabelText}"
                       Text="Clip"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <TextBox x:Name="ClipSearchBox"
                     Grid.Column="1"
                     Style="{StaticResource CompactTextBox}"
                     VerticalContentAlignment="Center"
                     Margin="0,0,8,0"
                     ToolTip="Search clips (case-insensitive)"
                     TextChanged="ClipSearchBox_TextChanged"/>
            <ComboBox x:Name="ClipCombo"
                      Grid.Column="2"
                      Style="{StaticResource CompactComboBox}"
                      DisplayMemberPath="FileName"
                      SelectionChanged="ClipCombo_SelectionChanged"/>
            <Button Grid.Column="3"
                    Content="Refresh"
                    Style="{StaticResource CompactPillButton}"
                    Margin="8,0,0,0"
                    Click="RefreshClips_Click"/>
            <Button Grid.Column="4"
                    Content="Delete"
                    Style="{StaticResource CompactPillButton}"
                    Margin="8,0,0,0"
                    Click="DeleteClip_Click"/>
        </Grid>

        <!-- Trim start | Trim end -->
        <Grid Grid.Row="2" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <DockPanel Margin="0,0,0,2">
                    <TextBlock Style="{StaticResource LabelText}" Text="Trim start" VerticalAlignment="Center"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBox x:Name="StartSecondsBox"
                                 Style="{StaticResource CompactTextBox}"
                                 Width="56"
                                 LostFocus="StartSecondsBox_LostFocus"
                                 KeyDown="TrimSecondsBox_KeyDown"/>
                        <TextBlock Text="s" Style="{StaticResource MutedText}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
                <Slider x:Name="StartSlider"
                        Minimum="0"
                        Maximum="1"
                        Value="0"
                        IsMoveToPointEnabled="True"
                        ValueChanged="TrimSlider_ValueChanged"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <DockPanel Margin="0,0,0,2">
                    <TextBlock Style="{StaticResource LabelText}" Text="Trim end" VerticalAlignment="Center"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBox x:Name="EndSecondsBox"
                                 Style="{StaticResource CompactTextBox}"
                                 Width="56"
                                 LostFocus="EndSecondsBox_LostFocus"
                                 KeyDown="TrimSecondsBox_KeyDown"/>
                        <TextBlock Text="s" Style="{StaticResource MutedText}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
                <Slider x:Name="EndSlider"
                        Minimum="0"
                        Maximum="1"
                        Value="1"
                        IsMoveToPointEnabled="True"
                        ValueChanged="TrimSlider_ValueChanged"/>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="SelectionLabel"
                   Grid.Row="3"
                   Style="{StaticResource MutedText}"
                   FontSize="11"
                   Margin="0,0,0,6"
                   Text="0.00s selected"/>

        <!-- Preview | Save as -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource LabelText}" Text="Preview trim" Margin="0,0,0,4"/>
                <ComboBox x:Name="PreviewOutputCombo"
                          Style="{StaticResource CompactComboBox}"
                          DisplayMemberPath="FriendlyName"
                          Margin="0,0,0,6"
                          SelectionChanged="PreviewOutputCombo_SelectionChanged"/>
                <WrapPanel>
                    <Button x:Name="PreviewButton"
                            Content="Preview"
                            Style="{StaticResource CompactAccentPillButton}"
                            Click="Preview_Click"
                            MinWidth="84"
                            Margin="0,0,8,0"/>
                    <Button Content="Stop"
                            Style="{StaticResource CompactPillButton}"
                            Click="StopPreview_Click"
                            MinWidth="64"/>
                </WrapPanel>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <DockPanel Margin="0,0,0,4" LastChildFill="False">
                    <TextBlock Style="{StaticResource LabelText}"
                               Text="Save as"
                               VerticalAlignment="Center"/>
                    <CheckBox x:Name="DeleteOriginalCheck"
                              Content="Delete original"
                              Margin="16,0,0,0"
                              VerticalAlignment="Center"/>
                </DockPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SaveNameBox"
                             Grid.Column="0"
                             Style="{StaticResource CompactTextBox}"
                             VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text=".wav"
                               Style="{StaticResource MutedText}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"/>
                </Grid>
                <Button Content="Save trimmed"
                        Style="{StaticResource CompactPillButton}"
                        HorizontalAlignment="Left"
                        Click="SaveTrimmed_Click"
                        MinWidth="100"/>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="StatusText"
                   Grid.Row="5"
                   TextWrapping="Wrap"
                   Style="{StaticResource MutedText}"
                   FontSize="11"
                   Margin="0,6,0,0"
                   Text="Select a clip to edit."/>
    </Grid>
</UserControl>
