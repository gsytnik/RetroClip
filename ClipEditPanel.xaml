<UserControl x:Class="RetroClip.ClipEditPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Text="Edit clip"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#7FFFD4"/>
            <TextBlock Style="{StaticResource MutedText}"
                       Text="Pick a clip, fine-tune trim, save or delete."
                       Margin="0,4,0,14"
                       TextWrapping="Wrap"/>

            <TextBlock Style="{StaticResource LabelText}" Text="Clip" Margin="0,0,0,8"/>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="ClipCombo"
                          Grid.Column="0"
                          DisplayMemberPath="FileName"
                          SelectionChanged="ClipCombo_SelectionChanged"/>
                <Button Grid.Column="1"
                        Content="Refresh"
                        Style="{StaticResource PillButton}"
                        Margin="8,0,0,0"
                        Click="RefreshClips_Click"/>
                <Button Grid.Column="2"
                        Content="Delete"
                        Style="{StaticResource PillButton}"
                        Margin="8,0,0,0"
                        Click="DeleteClip_Click"/>
            </Grid>

            <DockPanel Margin="0,0,0,6">
                <TextBlock Style="{StaticResource LabelText}" Text="Trim start" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBox x:Name="StartSecondsBox"
                             Width="72"
                             LostFocus="StartSecondsBox_LostFocus"
                             KeyDown="TrimSecondsBox_KeyDown"/>
                    <TextBlock Text="s" Style="{StaticResource MutedText}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
            <Slider x:Name="StartSlider"
                    Minimum="0"
                    Maximum="1"
                    Value="0"
                    IsMoveToPointEnabled="True"
                    Margin="0,0,0,10"
                    ValueChanged="TrimSlider_ValueChanged"/>

            <DockPanel Margin="0,0,0,6">
                <TextBlock Style="{StaticResource LabelText}" Text="Trim end" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBox x:Name="EndSecondsBox"
                             Width="72"
                             LostFocus="EndSecondsBox_LostFocus"
                             KeyDown="TrimSecondsBox_KeyDown"/>
                    <TextBlock Text="s" Style="{StaticResource MutedText}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
            <Slider x:Name="EndSlider"
                    Minimum="0"
                    Maximum="1"
                    Value="1"
                    IsMoveToPointEnabled="True"
                    Margin="0,0,0,10"
                    ValueChanged="TrimSlider_ValueChanged"/>

            <TextBlock x:Name="SelectionLabel"
                       Style="{StaticResource MutedText}"
                       Margin="0,0,0,10"
                       Text="0.00s selected"/>

            <TextBlock Style="{StaticResource LabelText}" Text="Preview trim" Margin="0,0,0,8"/>
            <ComboBox x:Name="PreviewOutputCombo"
                      DisplayMemberPath="FriendlyName"
                      Margin="0,0,0,8"/>
            <WrapPanel Margin="0,0,0,14">
                <Button x:Name="PreviewButton"
                        Content="Preview"
                        Style="{StaticResource AccentPillButton}"
                        Click="Preview_Click"
                        MinWidth="100"
                        Margin="0,0,8,0"/>
                <Button Content="Stop"
                        Style="{StaticResource PillButton}"
                        Click="StopPreview_Click"
                        MinWidth="80"/>
            </WrapPanel>

            <TextBlock Style="{StaticResource LabelText}" Text="Save as" Margin="0,0,0,8"/>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SaveNameBox" Grid.Column="0"/>
                <TextBlock Grid.Column="1"
                           Text=".wav"
                           Style="{StaticResource MutedText}"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"/>
            </Grid>
            <CheckBox x:Name="DeleteOriginalCheck"
                      Content="Delete original file after save"
                      Margin="0,0,0,10"/>
            <Button Content="Save trimmed"
                    Style="{StaticResource PillButton}"
                    HorizontalAlignment="Left"
                    Click="SaveTrimmed_Click"
                    MinWidth="110"
                    Margin="0,0,0,8"/>

            <Border Background="#1F1F1F"
                    BorderBrush="#3D3D3D"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    MinHeight="56"
                    Margin="0,8,0,0">
                <TextBlock x:Name="StatusText"
                           TextWrapping="Wrap"
                           Style="{StaticResource MutedText}"
                           Text="Select a clip to edit."/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
