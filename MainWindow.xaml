<Window x:Class="RetroClip.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RetroClip"
        Title="RetroClip"
        Height="920"
        Width="1280"
        MinHeight="860"
        MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#1F1F1F"
        Foreground="#F3F1ED"
        FontFamily="Segoe UI"
        FontSize="14">
    <Border Background="#1F1F1F" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="360"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto" MinHeight="220"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="RetroClip"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="#7FFFD4"/>
                <TextBlock Style="{StaticResource MutedText}"
                           Text="Capture + edit on top · playback / stream below"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="420"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*" MinWidth="420"/>
                </Grid.ColumnDefinitions>

                <!-- Capture -->
                <Border Grid.Column="0"
                        Background="#2A2A2A"
                        BorderBrush="#3D3D3D"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="18">
                    <StackPanel>
                        <TextBlock Text="Capture"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#7FFFD4"/>
                        <TextBlock Style="{StaticResource MutedText}"
                                   Text="Buffer per-app audio, then save a clip."
                                   Margin="0,4,0,14"/>

                        <TextBlock Style="{StaticResource LabelText}" Text="Application" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="AppCombo"
                                      Grid.Column="0"
                                      DisplayMemberPath="DisplayName"
                                      IsEditable="False"/>
                            <Button Grid.Column="1"
                                    Content="Refresh"
                                    Style="{StaticResource PillButton}"
                                    Margin="8,0,0,0"
                                    Click="RefreshApps_Click"/>
                        </Grid>
                        <TextBlock Style="{StaticResource MutedText}"
                                   Text="Only apps currently outputting audio appear here."
                                   Margin="0,0,0,14"
                                   FontSize="12"/>

                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource LabelText}" Text="Buffer length" VerticalAlignment="Center"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <TextBox x:Name="BufferSecondsBox"
                                         Width="56"
                                         LostFocus="BufferSecondsBox_LostFocus"
                                         KeyDown="BufferSecondsBox_KeyDown"/>
                                <TextBlock Text="s"
                                           Foreground="#7FFFD4"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                        <Slider x:Name="BufferSlider"
                                Minimum="10"
                                Maximum="120"
                                Value="120"
                                TickFrequency="1"
                                IsSnapToTickEnabled="False"
                                IsMoveToPointEnabled="True"
                                ValueChanged="BufferSlider_ValueChanged"/>
                        <TextBlock Style="{StaticResource MutedText}"
                                   FontSize="12"
                                   Margin="0,6,0,14"
                                   Text="10–120 seconds. Type exact value (e.g. 21)."/>

                        <WrapPanel Margin="0,0,0,14">
                            <Button x:Name="StartStopButton"
                                    Content="Start buffering"
                                    Style="{StaticResource AccentPillButton}"
                                    Click="StartStop_Click"
                                    MinWidth="130"
                                    Margin="0,0,8,8"/>
                            <Button x:Name="SaveButton"
                                    Content="Save clip"
                                    Style="{StaticResource PillButton}"
                                    Click="SaveClip_Click"
                                    IsEnabled="False"
                                    MinWidth="100"
                                    Margin="0,0,8,8"/>
                            <Button Content="Open folder"
                                    Style="{StaticResource PillButton}"
                                    Click="OpenFolder_Click"
                                    MinWidth="100"
                                    Margin="0,0,8,8"/>
                        </WrapPanel>

                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Style="{StaticResource LabelText}" Text="Buffered"/>
                            <TextBlock x:Name="BufferStatusLabel"
                                       DockPanel.Dock="Right"
                                       Style="{StaticResource MutedText}"
                                       Text="0.0s / 120s"/>
                        </DockPanel>
                        <ProgressBar x:Name="BufferProgress" Minimum="0" Maximum="1" Value="0" Margin="0,0,0,12"/>

                        <Border Background="#1F1F1F"
                                BorderBrush="#3D3D3D"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12"
                                MinHeight="56">
                            <TextBlock x:Name="StatusText"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource MutedText}"
                                       Text="Pick an app that is playing sound, then start buffering. Press Ctrl+Shift+R to save."/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Edit -->
                <Border Grid.Column="2"
                        Background="#2A2A2A"
                        BorderBrush="#3D3D3D"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="18">
                    <local:ClipEditPanel x:Name="EditPanel"/>
                </Border>
            </Grid>

            <!-- Playback full width -->
            <Border Grid.Row="3"
                    Background="#2A2A2A"
                    BorderBrush="#3D3D3D"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18">
                <local:ClipPlaybackPanel x:Name="PlaybackPanel"/>
            </Border>

            <TextBlock Grid.Row="4"
                       Style="{StaticResource MutedText}"
                       FontSize="12"
                       Margin="0,14,0,0"
                       Text="Hotkey: Ctrl+Shift+R · Saves to Music\RetroClip"/>
        </Grid>
    </Border>
</Window>
