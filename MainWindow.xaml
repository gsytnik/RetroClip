<Window x:Class="RetroClip.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RetroClip"
        Title="RetroClip"
        Height="1060"
        Width="1280"
        MinHeight="900"
        MinWidth="1100"
        WindowState="Normal"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#1F1F1F"
        Foreground="#F3F1ED"
        FontFamily="Segoe UI"
        FontSize="14">
    <Border Background="#1F1F1F" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="0.82*" MinHeight="260"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="1.18*" MinHeight="320"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="True">
                <TextBlock DockPanel.Dock="Right"
                           Style="{StaticResource MutedText}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0"
                           Text="Hotkey: Ctrl+Shift+R · Saves to Music\RetroClip"/>
                <TextBlock Text="RetroClip"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="#7FFFD4"
                           VerticalAlignment="Center"/>
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="420"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*" MinWidth="420"/>
                </Grid.ColumnDefinitions>

                <!-- Capture -->
                <Border Grid.Column="0"
                        Background="#2A2A2A"
                        BorderBrush="#3D3D3D"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="Capture"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="#7FFFD4"/>
                            <TextBlock Style="{StaticResource MutedText}"
                                       Text="Buffer per-app audio, then save a clip."
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LabelText}"
                                       Text="Application"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <ComboBox x:Name="AppCombo"
                                      Grid.Column="1"
                                      DisplayMemberPath="DisplayName"
                                      IsEditable="False"
                                      SelectionChanged="AppCombo_SelectionChanged"/>
                            <Button Grid.Column="2"
                                    Content="Refresh"
                                    Style="{StaticResource PillButton}"
                                    Margin="8,0,0,0"
                                    Click="RefreshApps_Click"/>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LabelText}"
                                       Text="Buffer length"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,0">
                                <TextBox x:Name="BufferSecondsBox"
                                         Width="56"
                                         Padding="8,4"
                                         LostFocus="BufferSecondsBox_LostFocus"
                                         KeyDown="BufferSecondsBox_KeyDown"/>
                                <TextBlock Text="s"
                                           Foreground="#7FFFD4"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <Slider x:Name="BufferSlider"
                                    Grid.Column="2"
                                    Minimum="10"
                                    Maximum="120"
                                    Value="120"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="False"
                                    IsMoveToPointEnabled="True"
                                    VerticalAlignment="Center"
                                    ValueChanged="BufferSlider_ValueChanged"/>
                        </Grid>

                        <WrapPanel Grid.Row="3" Margin="0,0,0,10">
                            <Button x:Name="StartStopButton"
                                    Content="Start buffering"
                                    Style="{StaticResource AccentPillButton}"
                                    Click="StartStop_Click"
                                    MinWidth="130"
                                    Margin="0,0,8,0"/>
                            <Button x:Name="SaveButton"
                                    Content="Save clip"
                                    Style="{StaticResource PillButton}"
                                    Click="SaveClip_Click"
                                    IsEnabled="False"
                                    MinWidth="100"
                                    Margin="0,0,8,0"/>
                            <Button Content="Open folder"
                                    Style="{StaticResource PillButton}"
                                    Click="OpenFolder_Click"
                                    MinWidth="100"/>
                        </WrapPanel>

                        <StackPanel Grid.Row="4" Margin="0,0,0,8">
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Style="{StaticResource LabelText}" Text="Buffered"/>
                                <TextBlock x:Name="BufferStatusLabel"
                                           DockPanel.Dock="Right"
                                           Style="{StaticResource MutedText}"
                                           Text="0.0s / 120s"/>
                            </DockPanel>
                            <ProgressBar x:Name="BufferProgress" Minimum="0" Maximum="1" Value="0"/>
                        </StackPanel>

                        <TextBlock x:Name="StatusText"
                                   Grid.Row="5"
                                   VerticalAlignment="Bottom"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource MutedText}"
                                   FontSize="12"
                                   Text="Pick an app that is playing sound, then start buffering. Ctrl+Shift+R saves."/>
                    </Grid>
                </Border>

                <!-- Edit -->
                <Border Grid.Column="2"
                        Background="#2A2A2A"
                        BorderBrush="#3D3D3D"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14">
                    <local:ClipEditPanel x:Name="EditPanel"/>
                </Border>
            </Grid>

            <!-- Playback full width -->
            <Border Grid.Row="3"
                    Background="#2A2A2A"
                    BorderBrush="#3D3D3D"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18">
                <local:ClipPlaybackPanel x:Name="PlaybackPanel"/>
            </Border>
        </Grid>
    </Border>
</Window>
